<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <PublishAot>true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- PublishAot restores for the host platform. Listing both keeps one lock file valid on Windows and on the Linux CI runner. -->
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.15" />
        <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WebSocket.Rx\WebSocket.Rx.csproj" />
    </ItemGroup>

</Project>
